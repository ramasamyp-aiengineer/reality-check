# Copy to .env. Never commit .env.

# SerpApi key. Optional: users can also paste their own key in the UI (kept in the session only by default).
SERPAPI_API_KEY=
# Allow server-side SERPAPI_API_KEY to be used for signed-in workspaces (1) or require users to bring their own (0).
ALLOW_ENV_SERPAPI_KEY=1

# Optional LLM for claim parsing, explanations, planning and ad copy. Rules work without it.
# Examples: openai:gpt-4.1-mini, anthropic:claude-sonnet-4-5, google-gla:gemini-2.5-flash, groq:llama-3.3-70b-versatile
# Local open-source model (nothing leaves your machine): install Ollama, `ollama pull qwen2.5:7b`, then
#   LLM_MODEL=ollama:qwen2.5:7b      (OLLAMA_BASE_URL defaults to http://localhost:11434/v1)
LLM_MODEL=
OLLAMA_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Security
# 32+ random bytes. If empty, a key is generated in data/.app_secret on first start.
APP_SECRET_KEY=
# Set to 1 behind HTTPS so cookies get the Secure flag and HSTS is sent.
COOKIE_SECURE=0
# Allow the one-click demo workspace (recorded evidence, no key needed).
ALLOW_DEMO_LOGIN=1
# Force every run to use recorded fixtures (offline demo).
RC_FORCE_DEMO=0

# Budgets (SerpApi searches)
RUN_SEARCH_BUDGET=15
MONTHLY_SEARCH_BUDGET=250

# Watch alerts
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional OAuth sign-in (invited users only)
PUBLIC_URL=http://127.0.0.1:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: point the registry agent at a fresh snapshot imported with
# python -m evidence_agents.tools.import_registry rbi_dla <file.xlsx>
RBI_DLA_SNAPSHOT=
SEBI_SNAPSHOT=
